<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox prefHeight="750.0" prefWidth="1200.0" styleClass="main-root" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="example.Controller.MaladieController">
   <children>
      <VBox prefWidth="280.0" styleClass="card, sidebar-card">
         <HBox.margin>
            <Insets bottom="20.0" left="20.0" top="20.0" />
         </HBox.margin>
         <children>
            <VBox alignment="CENTER" spacing="10.0">
               <padding><Insets bottom="30.0" top="30.0" /></padding>
               <children>
                  <Label styleClass="sidebar-app-name" text="MediCab" />
                  <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 13;" text="Cabinet Médical" />
               </children>
            </VBox>

            <Separator prefWidth="200.0">
               <VBox.margin><Insets left="20.0" right="20.0" /></VBox.margin>
            </Separator>

            <VBox spacing="10.0" VBox.vgrow="ALWAYS">
               <padding><Insets left="15.0" right="15.0" top="30.0" /></padding>
               <children>
                  <Label style="-fx-text-fill: #b0b0b0; -fx-font-weight: bold; -fx-font-size: 11;" text="MENU">
                     <VBox.margin><Insets left="10.0" /></VBox.margin>
                  </Label>
                  <Button alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#allerDashboard" styleClass="nav-btn" text="📊   Dashboard" />
                  <Button alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#allerPatients" styleClass="nav-btn" text="👤   Patients" />
                  <Button alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#allerMaladies" styleClass="nav-btn-active" text="📋   Maladies" />
                  <Button alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#allerRendezVous" styleClass="nav-btn" text="📅   Rendez-vous" />
               </children>
            </VBox>

            <VBox spacing="15.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 0 0 15 15;">
               <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="12.0">
                     <children>
                        <Label fx:id="initialesLabel" styleClass="user-avatar" text="??" />
                        <VBox alignment="CENTER_LEFT">
                           <children>
                              <Label fx:id="nomUtilisateurLabel" style="-fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Chargement..." />
                              <Label fx:id="roleLabel" style="-fx-font-size: 11; -fx-text-fill: #64748b;" text="Rôle" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <Button maxWidth="Infinity" onAction="#deconnexion" styleClass="btn-logout-sidebar" text="🚪 Déconnexion" />
               </children>
            </VBox>
         </children>
      </VBox>

      <VBox spacing="25.0" HBox.hgrow="ALWAYS">
         <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
         <children>
            <HBox alignment="CENTER_LEFT">
               <children>
                  <VBox spacing="5.0">
                     <children>
                        <Label styleClass="page-title" text="Gestion des Maladies" />
                        <Label fx:id="compteurLabel" style="-fx-text-fill: #64748b;" text="0 maladie(s) au total" />
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <TextField fx:id="rechercheField" onKeyReleased="#rechercherMaladie" prefWidth="320.0" promptText="🔍 Rechercher par code, nom, catégorie..." styleClass="form-field" />
               </children>
            </HBox>

            <VBox spacing="20.0" styleClass="card">
               <padding><Insets bottom="25.0" left="25.0" right="25.0" top="25.0" /></padding>
               <children>
                  <GridPane hgap="20.0" vgap="15.0">
                     <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                     </columnConstraints>
                     <children>
                        <VBox spacing="5.0">
                           <children>
                              <Label style="-fx-font-weight: bold; -fx-text-fill: #475569;" text="Code" />
                              <TextField fx:id="codeField" styleClass="form-field" />
                           </children>
                        </VBox>
                        <VBox spacing="5.0" GridPane.columnIndex="1">
                           <children>
                              <Label style="-fx-font-weight: bold; -fx-text-fill: #475569;" text="Nom maladie" />
                              <TextField fx:id="nomField" styleClass="form-field" />
                           </children>
                        </VBox>
                        <VBox spacing="5.0" GridPane.rowIndex="1">
                           <children>
                              <Label style="-fx-font-weight: bold; -fx-text-fill: #475569;" text="Catégorie" />
                              <TextField fx:id="categorieField" styleClass="form-field" />
                           </children>
                        </VBox>
                        <VBox spacing="5.0" GridPane.columnSpan="2" GridPane.rowIndex="2">
                           <children>
                              <Label style="-fx-font-weight: bold; -fx-text-fill: #475569;" text="Description" />
                              <TextArea fx:id="descriptionArea" prefRowCount="3" styleClass="form-field" />
                           </children>
                        </VBox>
                     </children>
                  </GridPane>

                  <HBox alignment="CENTER_RIGHT" spacing="15.0">
                     <children>
                        <Label fx:id="validationLabel" text="Message" visible="false" />
                        <Button onAction="#effacerFormulaire" prefWidth="100.0" style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569;" styleClass="btn-primary" text="Vider" />
                        <Button onAction="#supprimerMaladie" prefWidth="120.0" styleClass="btn-danger" text="Supprimer" />
                        <Button onAction="#modifierMaladie" prefWidth="120.0" style="-fx-background-color: #64748b;" styleClass="btn-primary" text="Modifier" />
                        <Button onAction="#ajouterMaladie" prefWidth="140.0" styleClass="btn-primary" text="+ Enregistrer" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <VBox styleClass="card" VBox.vgrow="ALWAYS">
               <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>
               <children>
                  <TableView fx:id="maladieTable" prefHeight="300.0" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="colCode" prefWidth="120.0" text="Code" />
                        <TableColumn fx:id="colNom" prefWidth="220.0" text="Nom" />
                        <TableColumn fx:id="colCategorie" prefWidth="180.0" text="Catégorie" />
                        <TableColumn fx:id="colDescription" prefWidth="350.0" text="Description" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</HBox>
